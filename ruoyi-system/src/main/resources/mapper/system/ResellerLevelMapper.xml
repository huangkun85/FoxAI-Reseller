<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ResellerLevelMapper">

    <resultMap type="ResellerLevel" id="ResellerLevelResult">
        <id     property="id"              column="id"              />
        <result property="levelCode"       column="level_code"      />
        <result property="levelName"       column="level_name"      />
        <result property="packageAmount"   column="package_amount"  />
        <result property="franchiseFee"    column="franchise_fee"   />
        <result property="tokenQuota"      column="token_quota"     />
        <result property="bonusAmount"     column="bonus_amount"    />
        <result property="commissionRate"  column="commission_rate" />
        <result property="referralReward"  column="referral_reward" />
        <result property="sortOrder"       column="sort_order"      />
        <result property="status"          column="status"          />
        <result property="remark"          column="remark"          />
        <result property="createBy"        column="create_by"       />
        <result property="createTime"      column="create_time"     />
        <result property="updateBy"        column="update_by"       />
        <result property="updateTime"      column="update_time"     />
    </resultMap>

    <sql id="selectResellerLevelVo">
        SELECT id, level_code, level_name, package_amount, franchise_fee,
               token_quota, bonus_amount, commission_rate, referral_reward,
               sort_order, status, remark, create_by, create_time, update_by, update_time
        FROM reseller_level
    </sql>

    <select id="selectResellerLevelById" parameterType="Long" resultMap="ResellerLevelResult">
        <include refid="selectResellerLevelVo"/>
        WHERE id = #{id}
    </select>

    <select id="selectResellerLevelList" parameterType="ResellerLevel" resultMap="ResellerLevelResult">
        <include refid="selectResellerLevelVo"/>
        <where>
            <if test="levelCode != null and levelCode != ''">
                AND level_code = #{levelCode}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        ORDER BY sort_order ASC
    </select>

    <insert id="insertResellerLevel" parameterType="ResellerLevel" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO reseller_level (
            level_code, level_name, package_amount, franchise_fee, token_quota,
            bonus_amount, commission_rate, referral_reward, sort_order,
            status, remark, create_by, create_time
        ) VALUES (
            #{levelCode}, #{levelName}, #{packageAmount}, #{franchiseFee}, #{tokenQuota},
            #{bonusAmount}, #{commissionRate}, #{referralReward}, #{sortOrder},
            #{status}, #{remark}, #{createBy}, sysdate()
        )
    </insert>

    <update id="updateResellerLevel" parameterType="ResellerLevel">
        UPDATE reseller_level
        SET level_code       = #{levelCode},
            level_name       = #{levelName},
            package_amount   = #{packageAmount},
            franchise_fee    = #{franchiseFee},
            token_quota      = #{tokenQuota},
            bonus_amount     = #{bonusAmount},
            commission_rate  = #{commissionRate},
            referral_reward  = #{referralReward},
            sort_order       = #{sortOrder},
            status           = #{status},
            remark           = #{remark},
            update_by        = #{updateBy},
            update_time      = sysdate()
        WHERE id = #{id}
    </update>

    <delete id="deleteResellerLevelByIds" parameterType="Long">
        DELETE FROM reseller_level WHERE id IN
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="checkLevelCodeUnique" parameterType="String" resultMap="ResellerLevelResult">
        <include refid="selectResellerLevelVo"/>
        WHERE level_code = #{levelCode} LIMIT 1
    </select>

</mapper>
