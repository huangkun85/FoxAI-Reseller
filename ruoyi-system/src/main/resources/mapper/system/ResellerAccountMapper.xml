<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ResellerAccountMapper">

    <resultMap type="ResellerAccount" id="ResellerAccountResult">
        <id     property="id"            column="id"             />
        <result property="userId"        column="user_id"        />
        <result property="levelId"       column="level_id"       />
        <result property="tokenQuota"    column="token_quota"    />
        <result property="tokenUsed"     column="token_used"     />
        <result property="bonusAmount"   column="bonus_amount"   />
        <result property="apiKey"        column="api_key"        />
        <result property="apiSecret"     column="api_secret"     />
        <result property="endpointUrl"   column="endpoint_url"   />
        <result property="status"        column="status"         />
        <result property="remark"        column="remark"         />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectVo">
        SELECT id, user_id, level_id, token_quota, token_used, bonus_amount,
               api_key, api_secret, endpoint_url, status, remark,
               create_by, create_time, update_by, update_time
        FROM reseller_account
    </sql>

    <select id="selectResellerAccountById" parameterType="Long" resultMap="ResellerAccountResult">
        <include refid="selectVo"/> WHERE id = #{id}
    </select>

    <select id="selectResellerAccountByUserId" parameterType="Long" resultMap="ResellerAccountResult">
        <include refid="selectVo"/> WHERE user_id = #{userId}
    </select>

    <select id="selectResellerAccountList" parameterType="ResellerAccount" resultMap="ResellerAccountResult">
        <include refid="selectVo"/>
        <where>
            <if test="userId != null">AND user_id = #{userId}</if>
        </where>
    </select>

    <insert id="insertResellerAccount" parameterType="ResellerAccount" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO reseller_account (
            user_id, level_id, token_quota, token_used, bonus_amount,
            api_key, api_secret, endpoint_url, status, remark, create_by, create_time
        ) VALUES (
            #{userId}, #{levelId}, #{tokenQuota}, #{tokenUsed}, #{bonusAmount},
            #{apiKey}, #{apiSecret}, #{endpointUrl}, #{status}, #{remark}, #{createBy}, sysdate()
        )
    </insert>

    <update id="updateResellerAccount" parameterType="ResellerAccount">
        UPDATE reseller_account
        SET token_quota   = #{tokenQuota},
            token_used    = #{tokenUsed},
            bonus_amount  = #{bonusAmount},
            api_key       = #{apiKey},
            api_secret    = #{apiSecret},
            endpoint_url  = #{endpointUrl},
            status        = #{status},
            remark        = #{remark},
            update_by     = #{updateBy},
            update_time   = sysdate()
        WHERE id = #{id}
    </update>

</mapper>
