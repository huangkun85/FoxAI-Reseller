<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ResellerPaymentMapper">

    <resultMap type="ResellerPayment" id="ResellerPaymentResult">
        <id     property="id"              column="id"               />
        <result property="orderNo"         column="order_no"         />
        <result property="userId"          column="user_id"          />
        <result property="levelId"         column="level_id"         />
        <result property="resellerType"    column="reseller_type"    />
        <result property="idNumber"        column="id_number"        />
        <result property="contactName"     column="contact_name"     />
        <result property="contactPhone"    column="contact_phone"    />
        <result property="contactEmail"    column="contact_email"    />
        <result property="amount"          column="amount"           />
        <result property="status"          column="status"           />
        <result property="remark"          column="remark"           />
        <result property="createBy"        column="create_by"        />
        <result property="createTime"      column="create_time"      />
        <result property="updateBy"        column="update_by"        />
        <result property="updateTime"      column="update_time"      />
    </resultMap>

    <sql id="selectVo">
        SELECT id, order_no, user_id, level_id, reseller_type, id_number,
               contact_name, contact_phone, contact_email,
               amount, status, remark, create_by, create_time, update_by, update_time
        FROM reseller_payment
    </sql>

    <select id="selectResellerPaymentById" parameterType="Long" resultMap="ResellerPaymentResult">
        <include refid="selectVo"/> WHERE id = #{id}
    </select>

    <select id="selectResellerPaymentList" parameterType="ResellerPayment" resultMap="ResellerPaymentResult">
        <include refid="selectVo"/>
        <where>
            <if test="userId != null">AND user_id = #{userId}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="selectPaymentsByUserId" parameterType="Long" resultMap="ResellerPaymentResult">
        <include refid="selectVo"/> WHERE user_id = #{userId} ORDER BY create_time DESC
    </select>

    <insert id="insertResellerPayment" parameterType="ResellerPayment" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO reseller_payment (
            user_id, level_id, reseller_type, id_number,
            contact_name, contact_phone, contact_email,
            amount, status, remark, create_by, create_time
        ) VALUES (
            #{userId}, #{levelId}, #{resellerType}, #{idNumber},
            #{contactName}, #{contactPhone}, #{contactEmail},
            #{amount}, '0', #{remark}, #{createBy}, sysdate()
        )
    </insert>

    <update id="updateOrderNo">
        UPDATE reseller_payment SET order_no = #{orderNo} WHERE id = #{id}
    </update>

    <update id="updateResellerPayment" parameterType="ResellerPayment">
        UPDATE reseller_payment
        SET status     = #{status},
            remark     = #{remark},
            update_by  = #{updateBy},
            update_time = sysdate()
        WHERE id = #{id}
    </update>

</mapper>
